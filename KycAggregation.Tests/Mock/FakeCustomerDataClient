namespace KycAggregation.Tests.Mock
{
    private sealed class FakeCustomerDataClient : ICustomerDataClient
    {
        private readonly AggregatedKycData _payload;

        public FakeCustomerDataClient(AggregatedKycData payload)
        {
            _payload = payload;
        }

        public bool WasCalled { get; private set; }

        public Task<AggregatedKycData> GetAsync(string ssn, CancellationToken cancellationToken = default)
        {
            WasCalled = true;
            return Task.FromResult(_payload with { Ssn = ssn });
        }
    }
}